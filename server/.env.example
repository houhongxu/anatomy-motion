# 同源网页来源 / Same-origin web application origin
APP_ORIGIN=http://localhost:3000
# 数据库绝对路径，默认 server/data/anatomy.sqlite / Absolute database path; default server/data/anatomy.sqlite
# DATABASE_PATH=/absolute/path/anatomy.sqlite
# 网页构建目录，默认 creator/build/web-desktop / Web build directory; default creator/build/web-desktop
# WEB_ROOT=/absolute/path/creator/build/web-desktop
HOST=127.0.0.1
PORT=3000
# HTTPS 生产环境启用；NODE_ENV=production 也会启用 / Enable for HTTPS production; NODE_ENV=production also enables it
COOKIE_SECURE=false
